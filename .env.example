# Optional. Absolute path where document JSON files are stored.
# Defaults to ./data/documents when unset.
# DOCYFIER_DATA_DIR=/absolute/path/to/data/documents

# How long one model call may take before it is abandoned, in
# milliseconds. Default 90000. Without it a stalled provider hangs the
# request forever.
DOCYFIER_LLM_TIMEOUT_MS=90000
